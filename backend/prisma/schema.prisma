generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  GUEST
  STUDENT
  TEACHER
  ADMIN
}

enum CourseLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum OAuthProvider {
  GOOGLE
  GITHUB
}

model User {
  id                 String         @id @default(uuid())
  email              String         @unique
  password           String?
  role               UserRole       @default(STUDENT)
  isEmailVerified    Boolean        @default(false)
  isPhoneVerified    Boolean        @default(false)
  phone              String?
  firstName          String?
  lastName           String?
  avatar             String?
  bio                String?
  dateOfBirth        DateTime?
  preferredLanguage  String?
  targetLanguages    String[]       @default([])
  timezone           String?
  oauthProvider      OAuthProvider?
  oauthId            String?
  isActive           Boolean        @default(true)
  deactivationReason String?        @db.Text
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Связи для авторизации
  verificationTokens VerificationToken[]
  passwordResets     PasswordReset[]
  
  // Связи для курсов
  teacherCourses    Course[]       @relation("TeacherCourses")
  enrollments       Enrollment[]
  progress          Progress[]     @relation("UserProgress")
  answers           Answer[]       @relation("UserAnswers")
  reviews           Review[]       @relation("UserReviews")
  certificates      Certificate[]  @relation("UserCertificates")

  // Placement test
  placementSessions PlacementSession[]

  @@unique([oauthProvider, oauthId])
  @@map("users")
}

model VerificationToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  type      String   // EMAIL, PHONE
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("verification_tokens")
}

model PasswordReset {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("password_resets")
}

model FAQItem {
  id        String   @id @default(uuid())
  question  String
  answer    String
  category  String
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([isActive])
  @@index([order])
  @@map("faq_items")
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  subject   String
  message   String
  isRead    Boolean  @default(false)
  isReplied Boolean  @default(false)
  adminNote String?
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([isReplied])
  @@index([createdAt])
  @@map("contact_messages")
}

// Курсы и обучение
enum CourseStatus {
  DRAFT           // Черновик (создание курса)
  PENDING_REVIEW  // Отправлен на модерацию (устанавливает преподаватель)
  IN_REVIEW       // На модерации (устанавливает админ)
  REJECTED        // Отклонен
  PUBLISHED       // Опубликован
  ARCHIVED        // Архивирован
}

enum LessonType {
  VIDEO       // Видео урок
  TEXT        // Текстовый материал
  INTERACTIVE // Интерактивный урок
  LEXICAL     // Лексический тренажёр
  DIALOGUE    // Диалоговый урок
  TEST        // Тест
}

enum QuestionType {
  SINGLE_CHOICE   // Один правильный ответ
  MULTIPLE_CHOICE // Несколько правильных ответов
  TRUE_FALSE      // Верно/Неверно
  FILL_IN_BLANK   // Заполнить пропуски
  MATCHING        // Сопоставление
}

/// Тип вопроса в placement-тесте
enum PlacementQuestionType {
  GRAMMAR   // Грамматика / Use of English
  VOCAB     // Лексика
  READING   // Чтение
  LISTENING // Аудирование
}

/// Статус сессии placement-теста
enum PlacementSessionStatus {
  IN_PROGRESS
  COMPLETED
}

model Course {
  id              String        @id @default(uuid())
  title           String
  description     String        @db.Text
  shortDescription String?      @db.Text
  level           CourseLevel
  language        String        @default("Английский")
  category        String?
  
  // Преподаватель
  teacherId       String
  teacher         User          @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: Cascade)
  
  // Контент и медиа
  coverImage      String?
  previewVideo    String?       // URL видео-превью
  duration        Int?          // Продолжительность в минутах
  lessonsCount    Int           @default(0)
  
  // Статус и публикация
  status          CourseStatus  @default(DRAFT)
  isPublished     Boolean       @default(false)
  publishedAt     DateTime?
  
  // Цена (в копейках для точности)
  price           Int           @default(0) // 0 = бесплатный курс
  currency        String        @default("BYN")
  
  // Статистика
  enrolledCount   Int           @default(0)
  averageRating   Float?
  reviewsCount    Int           @default(0)
  
  // Метаданные
  tags            String[]      @default([])
  prerequisites   String[]      @default([]) // ID предварительных курсов
  learningOutcomes String[]     @default([]) // Что изучит студент
  // Модерация
  lastReviewComment String?     @db.Text
  lastReviewedAt   DateTime?
  lastReviewedById String?
  
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Отношения
  lessons         Lesson[]
  enrollments     Enrollment[]
  reviews         Review[]
  certificates    Certificate[]
  progress        Progress[]

  @@index([teacherId])
  @@index([level])
  @@index([status])
  @@index([isPublished])
  @@index([category])
  @@map("courses")
}

model Lesson {
  id          String     @id @default(uuid())
  courseId    String
  course      Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  // Основная информация
  title       String
  description String?    @db.Text
  order       Int        // Порядок урока в курсе
  type        LessonType @default(VIDEO)
  isFinalTest Boolean    @default(false)
  
  // Контент
  content     String?    @db.Text // Markdown или HTML контент
  videoUrl    String?    // URL видео (YouTube, Vimeo, или собственный)
  duration    Int?       // Продолжительность в секундах
  
  // Файлы и ресурсы
  attachments Json?      // [{name: string, url: string, size: number}]
  
  // Доступность
  isPublished Boolean    @default(true)
  
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Отношения
  questions   Question[]
  progress    Progress[]

  @@index([courseId])
  @@index([order])
  @@map("lessons")
}

model Question {
  id          String       @id @default(uuid())
  lessonId    String
  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  type        QuestionType
  order       Int          // Порядок вопроса в тесте
  
  // Контент вопроса
  question    String       @db.Text
  explanation String?      @db.Text // Объяснение правильного ответа
  
  // Ответы (JSON для гибкости разных типов вопросов)
  options     Json         // [{id: string, text: string, isCorrect: boolean}]
  
  // Настройки
  points      Int          @default(1)
  timeLimit   Int?         // Время на ответ в секундах (опционально)
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Отношения
  answers     Answer[]

  @@index([lessonId])
  @@index([order])
  @@map("questions")
}

model Enrollment {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  // Статус зачисления
  enrolledAt  DateTime  @default(now())
  startedAt   DateTime? // Когда начал проходить
  completedAt DateTime? // Когда завершил
  
  // Прогресс
  progress    Float     @default(0) // 0-100%
  
  // Доступ
  expiresAt   DateTime? // Дата окончания доступа (для платных курсов с ограничением)
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
  @@index([completedAt])
  @@map("enrollments")
}

model Progress {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation("UserProgress", fields: [userId], references: [id], onDelete: Cascade)
  courseId    String
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId    String
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  
  // Прогресс урока
  isCompleted Boolean   @default(false)
  completedAt DateTime?
  
  // Статистика
  timeSpent   Int       @default(0) // Время в секундах
  attempts    Int       @default(0) // Количество попыток
  score       Float?    // Оценка за тест (0-100)
  
  // Ответы на вопросы
  lastPosition Int      @default(0) // Последняя позиция в видео/контенте
  
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([courseId])
  @@index([lessonId])
  @@index([isCompleted])
  @@map("progress")
}

model Answer {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation("UserAnswers", fields: [userId], references: [id], onDelete: Cascade)
  questionId  String
  question    Question  @relation(fields: [questionId], references: [id], onDelete: Cascade)
  
  // Ответ пользователя
  answer      Json      // Зависит от типа вопроса: string, string[], {from: string, to: string}[]
  isCorrect   Boolean
  
  // Статистика
  timeSpent   Int?      // Время на ответ в секундах
  attempts    Int       @default(1)
  
  createdAt   DateTime  @default(now())

  @@index([userId])
  @@index([questionId])
  @@map("answers")
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("UserReviews", fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  rating    Int      // 1-5 звезд
  comment   String?  @db.Text
  
  // Модерация
  isVisible Boolean  @default(true)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, courseId]) // Один отзыв на курс
  @@index([courseId])
  @@index([rating])
  @@index([isVisible])
  @@map("reviews")
}

model Certificate {
  id               String   @id @default(uuid())
  userId           String
  user             User     @relation("UserCertificates", fields: [userId], references: [id], onDelete: Cascade)
  courseId         String
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  
  // Данные сертификата
  certificateCode  String   @unique // Уникальный код для верификации
  issuedAt         DateTime @default(now())
  
  // PDF
  pdfUrl           String?  // URL сгенерированного PDF
  
  // Статистика курса
  finalScore       Float?   // Финальная оценка
  completionTime   Int?     // Время прохождения в днях
  
  @@unique([userId, courseId]) // Один сертификат на курс
  @@index([userId])
  @@index([courseId])
  @@index([certificateCode])
  @@map("certificates")
}

/// Вопрос placement-теста
model PlacementQuestion {
  id          String                @id @default(uuid())
  language    String                                // Целевой язык (например, "Английский", "German", "en")
  type        PlacementQuestionType                 // Тип навыка
  difficulty  Int                                   // 1–6, примерно A1–C2

  prompt      String                @db.Text        // Текст вопроса
  context     String?               @db.Text        // Дополнительный текст / отрывок (для Reading, Listening)
  mediaUrl    String?                               // URL аудио (для Listening) или другого ресурса

  // Варианты ответов (0..n). correctOptionIndex указывает на правильный.
  options             String[]                       // Тексты опций
  correctOptionIndex  Int
  explanation         String?        @db.Text       // Объяснение правильного ответа (для результата)

  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  // Связи
  answers     PlacementAnswer[]

  @@index([language])
  @@index([type])
  @@index([difficulty])
  @@map("placement_questions")
}

/// Сессия прохождения placement-теста
model PlacementSession {
  id           String                 @id @default(uuid())
  userId       String?
  user         User?                  @relation(fields: [userId], references: [id], onDelete: SetNull)

  language     String                                 // Язык, для которого проходит тест
  status       PlacementSessionStatus @default(IN_PROGRESS)

  startedAt    DateTime               @default(now())
  finishedAt   DateTime?

  // Результаты
  estimatedLevel CourseLevel?                        // Расчитанный уровень A1–C2
  rawScore       Int              @default(0)        // Числовой балл
  totalQuestions Int              @default(0)        // Сколько вопросов было пройдено

  // Технические поля
  // Сохраняем последний использованный уровень сложности (для адаптации)
  currentDifficulty Int?                             // 1–6

  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  // Связи
  answers      PlacementAnswer[]

  @@index([userId])
  @@index([language])
  @@index([status])
  @@map("placement_sessions")
}

/// Ответ пользователя в рамках placement-теста
model PlacementAnswer {
  id          String           @id @default(uuid())
  sessionId   String
  session     PlacementSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  questionId  String
  question    PlacementQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  givenOptionIndex Int                        // Индекс выбранного варианта
  isCorrect        Boolean
  timeMs           Int?                       // Время на ответ в миллисекундах

  createdAt   DateTime        @default(now())

  @@index([sessionId])
  @@index([questionId])
  @@map("placement_answers")
}

/// Глобальные настройки платформы (singleton запись)
model PlatformSettings {
  id                           Int      @id @default(1)
  requireFinalTestForCertificate Boolean @default(true)
  minProgressForCertificate    Int      @default(100) // 0-100 (%)
  lowRatingThreshold           Float    @default(2.5)
  minEnrollmentsForRating      Int      @default(5)
  placementDefaultQuestions    Int      @default(25)
  placementAllowedLanguages    String[] @default([])
  placementRecommendationMap   Json?
  updatedAt                    DateTime @updatedAt

  @@map("platform_settings")
}
