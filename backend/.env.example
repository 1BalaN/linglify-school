# ===========================================
# ENVIRONMENT
# ===========================================
NODE_ENV=development
PORT=5000

# ===========================================
# FRONTEND URL
# ===========================================
# Development
FRONTEND_URL=http://localhost:3000
# Production (замените на ваш домен)
# FRONTEND_URL=https://linglify.vercel.app

# ===========================================
# DATABASE (PostgreSQL)
# ===========================================
# Development (локальный PostgreSQL)
DATABASE_URL=postgresql://postgres:password@localhost:5432/linglify

# Production (Neon или другой хостинг)
# DATABASE_URL=postgresql://user:pass@ep-xxx.neon.tech/linglify?sslmode=require

# ===========================================
# REDIS (опционально для production)
# ===========================================
# Development (локальный Redis)
REDIS_URL=redis://localhost:6379

# Production (Upstash Redis)
# REDIS_URL=rediss://default:xxx@xxx.upstash.io:6379

# ===========================================
# JWT SECRETS (ОБЯЗАТЕЛЬНО!)
# ===========================================
# Генерация: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=generate-random-32-char-string-here
JWT_REFRESH_SECRET=generate-different-random-32-char-string-here
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# GOOGLE OAUTH 2.0
# ===========================================
# Получить: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
# Development
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
# Production
# GOOGLE_REDIRECT_URI=https://your-api.railway.app/api/auth/google/callback

# ===========================================
# EMAIL SERVICE - SMTP
# ===========================================
# Рекомендуется: Gmail, Yandex, Mail.ru
# Инструкции по настройке: docs/THIRD_PARTY_SERVICES.md
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Linglify

# ===========================================
# SMS SERVICE - TWILIO
# ===========================================
# Получить: https://www.twilio.com/console (FREE trial: $15.50)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+15005550006

# ===========================================
# PAYMENT - STRIPE (опционально)
# ===========================================
# Получить: https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx

# ===========================================
# ANALYTICS (опционально)
# ===========================================
GA_TRACKING_ID=G-XXXXXXXXXX

# ===========================================
# CORS ORIGINS (опционально)
# ===========================================
# Разрешенные origins для CORS (через запятую)
# ALLOWED_ORIGINS=http://localhost:3000,https://linglify.vercel.app

# ===========================================
# RATE LIMITING
# ===========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX=5

# ===========================================
# FILE UPLOAD (опционально)
# ===========================================
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/webp

# ===========================================
# LOGGING
# ===========================================
LOG_LEVEL=debug
