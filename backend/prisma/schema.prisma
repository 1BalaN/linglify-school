generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  GUEST
  STUDENT
  TEACHER
  ADMIN
}

enum CourseLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  password      String?
  role          UserRole  @default(STUDENT)
  isVerified    Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@map("users")
}
